# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object storage (S3-compatible; MinIO locally)
# STORAGE_ENDPOINT is used for server-to-server calls and must be the Compose
# service name. STORAGE_PUBLIC_ENDPOINT is used only to sign URLs handed to a
# browser: a URL signed with the internal name resolves only inside Docker.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://storage.streamtube.local:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_VIDEOS_BUCKET=streamtube-videos
STORAGE_THUMBNAILS_BUCKET=streamtube-thumbnails

# Processing queue (BullMQ over Redis)
QUEUE_HOST=redis
QUEUE_PORT=6379

# Video upload and playback
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=104857600
VIDEO_UPLOAD_URL_TTL_SECONDS=3600
VIDEO_PLAYBACK_URL_TTL_SECONDS=900
VIDEO_PROCESSING_URL_TTL_SECONDS=7200
VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm,video/x-msvideo
